# Required. The app does not fall back to a local JSON database.
# Set these in Vercel Project Settings → Environment Variables.
# The publishable/anon key belongs in NEXT_PUBLIC_SUPABASE_ANON_KEY.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Set to true only after Google is enabled in the Supabase dashboard.
NEXT_PUBLIC_AUTH_GOOGLE=

# Optional. Forces magic-link and Google redirects to this origin.
# Leave empty to use the host of the current request.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Not used by the running app. Only for a throwaway `npm run seed:supabase`.
# Do not set this on Vercel.
# SUPABASE_SERVICE_ROLE_KEY=
